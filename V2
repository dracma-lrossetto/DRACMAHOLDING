        let staffInit=false;
        function switchView(viewId,btn){
            document.querySelectorAll('.view-tab').forEach(t=>t.classList.remove('active'));btn.classList.add('active');
            const est=document.getElementById('view-estructura'),det=document.getElementById('view-detalle'),leg=document.getElementById('legend-bar');
            if(viewId==='global'){est.classList.remove('hidden');est.style.display='flex';det.classList.remove('visible');leg.style.display='flex';}
            else{est.classList.add('hidden');est.style.display='none';det.classList.add('visible');leg.style.display='none';if(!staffInit){renderStaffingTable();staffInit=true;}}
        }

        /* ═══════════════════════════════════════════
           PERSISTENCE: localStorage + JSON Export/Import
        ═══════════════════════════════════════════ */
        const STORAGE_KEY = 'holding_staffing_data_v1';

        // Auto-save to localStorage on every change
        function saveToLocal() {
            const data = staffingData.map(p => ({ id: p.id, n: p.n, c: p.c }));
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
                flashSaveIndicator();
            } catch(e) { /* silently fail if storage full */ }
        }

        // Load from localStorage on init
        function loadFromLocal() {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                if (!raw) return false;
                const saved = JSON.parse(raw);
                if (!Array.isArray(saved)) return false;
                saved.forEach(s => {
                    const pos = staffingData.find(p => p.id === s.id);
                    if (pos) { pos.n = s.n || ''; pos.c = s.c || 0; }
                });
                return true;
            } catch(e) { return false; }
        }

        // Flash "Guardado" indicator
        let saveTimeout;
        function flashSaveIndicator() {
            const el = document.getElementById('save-indicator');
            if (!el) return;
            el.style.opacity = '1';
            clearTimeout(saveTimeout);
            saveTimeout = setTimeout(() => { el.style.opacity = '0'; }, 1500);
        }

        // Export JSON
        function exportStaffingJSON() {
            const data = staffingData.map(p => ({
                id: p.id,
                posicion: p.pos,
                area: p.area,
                entidad: p.ent,
                jerarquia: p.hier,
                nombre: p.n,
                costo_anual_usd: p.c
            }));
            const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            const today = new Date().toISOString().slice(0, 10);
            a.download = `dotacion_holding_${today}.json`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

        // Import JSON
        function importStaffingJSON(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const imported = JSON.parse(e.target.result);
                    if (!Array.isArray(imported)) { alert('Formato inválido'); return; }
                    imported.forEach(row => {
                        const pos = staffingData.find(p => p.id === row.id);
                        if (pos) {
                            pos.n = row.nombre || row.n || '';
                            pos.c = row.costo_anual_usd || row.c || 0;
                        }
                    });
                    saveToLocal();
                    if (staffInit) renderStaffingTable();
                    alert('Datos importados correctamente (' + imported.length + ' posiciones)');
                } catch(err) {
                    alert('Error al leer el archivo: ' + err.message);
                }
            };
            reader.readAsText(file);
            event.target.value = ''; // reset input
        }

        /* ═══════════════════════════════════════════
           INIT
        ═══════════════════════════════════════════ */
        window.addEventListener('load',()=>{
            loadFromLocal(); // Restore saved data before anything renders
            updateNavHeadcount();
        });
    </script>
</body>
</html>
