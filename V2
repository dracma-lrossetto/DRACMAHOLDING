        const usdFmt = new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',minimumFractionDigits:0,maximumFractionDigits:0});
        function intFmt(n){return n?n.toLocaleString('es-AR'):'';}
        function parseNum(s){return parseInt(String(s).replace(/\./g,'').replace(/,/g,''))||0;}

        function renderStaffingTable(){
            const tbody=document.getElementById('staffing-tbody'); tbody.innerHTML=''; let curArea='';
            staffingData.forEach((p,i)=>{
                if(p.area!==curArea){curArea=p.area; const r=document.createElement('tr'); r.className='area-header'; r.innerHTML=`<td colspan="6"><div class="area-name-cell"><span class="area-dot" style="background:${p.ac};"></span>${p.area}</div></td>`; tbody.appendChild(r);}
                const tr=document.createElement('tr'); tr.className=`pos-row ${p.lead?'is-leader':'is-sub'}`;
                const indent=p.lead?'':'<span class="hierarchy-indent"></span>';
                tr.innerHTML=`<td><div class="pos-title-cell">${indent}<span class="pos-name">${p.pos}</span></div></td><td class="center"><span class="entity-badge ${p.ent}" style="font-size:9px;">${p.ent==='alyc'?'ALYC':'SGFCI'}</span></td><td class="center" style="font-size:11px;color:var(--slate-500);">${p.hier}</td><td><input type="text" class="staff-input" placeholder="Vacante" value="${p.n}" data-idx="${i}" data-field="name" onchange="updField(this)"></td><td><input type="text" class="staff-input cost-input" placeholder="0" value="${p.c?intFmt(p.c):''}" data-idx="${i}" onchange="updCost(this)" onblur="fmtCost(this)"></td><td class="center"><div class="expand-icon" onclick="openModal(${i})" title="Ver detalle">▸</div></td>`;
                tr.addEventListener('click',(e)=>{if(e.target.tagName!=='INPUT')openModal(i);});
                tbody.appendChild(tr);
            });
            updSummary();
        }
        function updField(el){staffingData[parseInt(el.dataset.idx)].n=el.value;updSummary();saveToLocal();}
        function updCost(el){staffingData[parseInt(el.dataset.idx)].c=parseNum(el.value);updSummary();saveToLocal();}
        function fmtCost(el){const v=parseNum(el.value);el.value=v>0?intFmt(v):'';}
        function updSummary(){
            document.getElementById('sum-hc').innerText=staffingData.length;
            document.getElementById('sum-filled').innerText=staffingData.filter(p=>p.n.trim()!=='').length;
            document.getElementById('sum-cost').innerText=usdFmt.format(staffingData.reduce((s,p)=>s+(p.c||0),0));
        }

