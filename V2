        function openModal(i){
            const p=staffingData[i];
            document.getElementById('rm-title').innerText=p.pos;
            document.getElementById('rm-area').innerText=p.area;
            document.getElementById('rm-meta').innerHTML=`<div class="rm-meta-item"><div class="meta-label">Nómina</div><div class="meta-value"><span class="entity-badge ${p.ent}" style="font-size:10px;">${p.ent==='alyc'?'ALYC':'SGFCI'}</span></div></div><div class="rm-meta-item"><div class="meta-label">Jerarquía</div><div class="meta-value">${p.hier}</div></div><div class="rm-meta-item"><div class="meta-label">Reporta a</div><div class="meta-value">${p.rep}</div></div><div class="rm-meta-item"><div class="meta-label">Gente a cargo</div><div class="meta-value">${p.dr} ${p.dr===1?'persona':'personas'}</div></div><div class="rm-meta-item"><div class="meta-label">Asignado</div><div class="meta-value">${p.n||'— Vacante —'}</div></div><div class="rm-meta-item"><div class="meta-label">Costo Anual</div><div class="meta-value" style="color:var(--gold-600);">${p.c?usdFmt.format(p.c):'— Sin definir —'}</div></div>`;
            const tl=document.getElementById('rm-tasks');tl.innerHTML='';p.tasks.forEach(t=>{const li=document.createElement('li');li.innerText=t;tl.appendChild(li);});
            document.getElementById('rm-expectations').innerText=p.exp;
            document.getElementById('role-modal-overlay').classList.add('visible');
        }
        function closeRoleModal(e){if(e&&e.target!==e.currentTarget)return;document.getElementById('role-modal-overlay').classList.remove('visible');}
        document.addEventListener('keydown',(e)=>{if(e.key==='Escape')document.getElementById('role-modal-overlay').classList.remove('visible');});

        /* ═══════════════════════════════════════════
           STRUCTURE VIEW — NODE SELECTION
        ═══════════════════════════════════════════ */
        let selectedNode=null;
        function selectNode(nodeId){
            const data=orgData[nodeId];if(!data)return;
            document.querySelectorAll('.node').forEach(el=>el.classList.remove('selected'));
            const nodeEl=document.getElementById(`node-${nodeId}`);if(nodeEl)nodeEl.classList.add('selected');
            selectedNode=nodeId;
            document.getElementById('panel-empty').style.display='none';
            const content=document.getElementById('panel-content');content.classList.add('visible');
            const tagEl=document.getElementById('detail-tag');tagEl.innerText=data.tag;tagEl.style.background=data.tagBg;tagEl.style.color=data.tagColor;
            document.getElementById('detail-title').innerText=data.title;
            document.getElementById('detail-desc').innerText=data.desc;
            const bc=document.getElementById('focus-bars');bc.innerHTML='';
            const fc=['blue','purple','emerald','rose','amber'];let idx=0;
            for(const[l,v]of Object.entries(data.focus)){bc.innerHTML+=`<div class="focus-bar-row"><span class="focus-bar-label">${l}</span><div class="focus-bar-track"><div class="focus-bar-fill ${fc[idx%5]}" style="width:${(v/5)*100}%;"></div></div></div>`;idx++;}
            const ms=document.getElementById('sec-middle'),mc=document.getElementById('middle-mgmt-content');
            if(data.middle){ms.style.display='';mc.innerHTML=`<div class="mgmt-title"><span class="entity-badge ${data.middle.entity==='sg'?'sg':'alyc'}" style="font-size:10px;">${data.middle.title}</span></div><div class="mgmt-subtitle">Coordination Role</div>`;}else{ms.style.display='none';}
            const rs=document.getElementById('sec-roles'),rc=document.getElementById('roles-container');rc.innerHTML='';
            if(data.roles.length>0){rs.style.display='';data.roles.forEach(r=>{rc.innerHTML+=`<div class="role-card"><div class="role-title"><span class="entity-badge ${r.entity==='sg'?'sg':'alyc'}" style="font-size:9px;">${r.title}</span></div><div class="role-desc">${r.desc}</div></div>`;});}else{rs.style.display='none';}
            const rl=document.getElementById('resp-list');rl.innerHTML='';data.resp.forEach(item=>{const li=document.createElement('li');li.innerText=item.text;if(item.highlight)li.classList.add('highlight');rl.appendChild(li);});
        }

